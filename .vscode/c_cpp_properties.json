{
    "version": 4,
    "configurations": [
        {
            "name": "ROS2",
            "type": "gcc",
            "request": "configure",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "defines": [],
            "includePath": [
                // 1. 你的工作空间
                "${workspaceFolder}/src/**",
                "${workspaceFolder}/install/**/include",

                // 2. ROS2 Humble 系统头文件
                "/opt/ros/humble/include/**",

                // 3. OpenCV
                "/usr/include/opencv4/**",

                // 4. 系统标准库
                "/usr/include/**",
                "/usr/local/include/**"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ]
}